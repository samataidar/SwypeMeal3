{
  // Optional single-Worker deployment. Useful for a no-account test:
  //   npx wrangler deploy --config wrangler.worker.jsonc --temporary
  // The regular Pages deploy uses wrangler.toml and functions/.
  "name": "swypemeal-test",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback can answer /api/* before the Worker runs.
    "run_worker_first": ["/api/*", "/images/*"]
  }
}
