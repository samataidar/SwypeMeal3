# Supabase configuration
# Backend uses the Supabase REST API, not a direct PostgreSQL connection.
SUPABASE_URL=https://bbelyefgpptozjfmeyqq.supabase.co
# Use the service_role key on the server. Never expose it to the frontend.
SUPABASE_KEY=your-service-role-key-here
USE_SUPABASE=true

# Comma-separated list of allowed frontend origins.
# Vercel preview deployments for swype-meal3 are allowed automatically.
CORS_ORIGINS=https://swype-meal3.vercel.app,https://swypemeal.ru,https://www.swypemeal.ru,http://localhost:3000,http://localhost:5173

# Development-only escape hatch. When true, requests without a Bearer token
# may authenticate via the X-User-ID header. Never enable in production.
ALLOW_INSECURE_AUTH=false
