# Supabase Configuration
# Скопируйте этот файл в .env и заполните значения

# Supabase PostgreSQL Connection String
# Получить: Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bbelyefgpptozjfmeyqq.supabase.co:5432/postgres

# Enable database mode (true = PostgreSQL, false = file storage)
USE_DATABASE=true

# Supabase API Keys (опционально, для прямого доступа из frontend)
VITE_SUPABASE_URL=https://bbelyefgpptozjfmeyqq.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary Configuration (для загрузки изображений)
# Получить: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
