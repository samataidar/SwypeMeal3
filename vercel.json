{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://swypemeal.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://images.unsplash.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
